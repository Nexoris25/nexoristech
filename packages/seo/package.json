{
  "name": "@nexoris/seo",
  "version": "0.0.0",
  "private": true,
  "description": "SEO engine for the Nexoris Technologies platform: JSON-LD @graph builders, buildMetadata, the branded OG card generator, split sitemaps, robots.txt, llms.txt, and the check:seo gate.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src",
    "type-check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "check:seo": "node ./dist/check/cli.js"
  },
  "devDependencies": {
    "@nexoris/config": "workspace:*",
    "@types/node": "22",
    "eslint": "10.10.0",
    "typescript": "5.7.2",
    "vitest": "3.2.7"
  }
}
