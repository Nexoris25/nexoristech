{
  "name": "@nexoris/ui",
  "version": "0.0.0",
  "private": true,
  "description": "The Nexoris Technologies design system: components for three font contexts, responsive tables, the keyboard-correct header flyouts, the mobile drawer and TOC, and the four data states.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/globals.css",
    "./fonts.css": "./src/styles/fonts.css"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src",
    "type-check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "check:a11y": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@nexoris/config": "workspace:*",
    "@testing-library/react": "16.1.0",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "4.3.4",
    "axe-core": "4.10.2",
    "clsx": "2.1.1",
    "eslint": "10.10.0",
    "jsdom": "25.0.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2",
    "vitest": "3.2.7"
  }
}
