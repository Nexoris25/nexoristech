# ====================================================================================================
# Production environment — the VPS
# ====================================================================================================
#
# Copy the three blocks below into the three files named in their headers, on the server, and fill in
# the four secrets marked <...>. Nothing here is a secret as written; the real values stay on the VPS
# and are never committed. This file is the reference, checked in so it cannot drift from the code.
#
# Two rules explain almost every value here.
#
#   1. Everything on the VPS talks to everything else on the VPS over 127.0.0.1. Postgres, the Oge
#      gateway and the media directory are all on the same machine, so naming the server's public IP
#      would send traffic out to the network card and back for no reason, and would expose Postgres
#      to anything that can reach that address. Loopback is both faster and closed.
#
#   2. Only the addresses a *browser* uses are public. That is APP_URL and WEB_ORIGIN, and nothing
#      else. Everything else being loopback is correct and is not a mistake to be "fixed" later.
#
# Ports: web 3000, admin 3102, Oge 4000.
#
# Postgres is on port 5435, not the default 5432. Check before assuming:
#
#   ss -lntp | grep -E '543[0-9]'
#
# and confirm the whole configuration with `node scripts/doctor.mjs` from the repository root, which
# connects to each database and each service and names anything it cannot reach.
#
# ====================================================================================================


# ----------------------------------------------------------------------------------------------------
# /var/www/nexoristech/apps/web/.env.local          (the public website, port 3000)
# ----------------------------------------------------------------------------------------------------
# Do not set NODE_ENV. Next sets it: production for `next build` and `next start`, development for
# `next dev`. Pinning it by hand is how a development machine ends up behaving as production.

DATABASE_URL_CMS=postgresql://nexoristech:<DB_PASSWORD>@127.0.0.1:5435/nexoris_cms?schema=public

# The gateway on this same machine.
OGE_GATEWAY_URL=http://127.0.0.1:4000

# Where /uploads/* is proxied from. The browser never sees this: the web server fetches the file and
# serves it from its own origin, which is why the admin does not need to be publicly reachable.
CMS_MEDIA_BASE=http://127.0.0.1:3102

# Must match the value in the admin file below; the admin calls the website with it to revalidate.
REVALIDATION_SECRET=<REVALIDATION_SECRET>

NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-Y1ZM9PF3N3
INDEXNOW_KEY=<INDEXNOW_KEY>


# ----------------------------------------------------------------------------------------------------
# /var/www/nexoristech/apps/admin/.env.local        (the admin platform, port 3102)
# ----------------------------------------------------------------------------------------------------

DATABASE_URL_ADMIN=postgresql://nexoristech:<DB_PASSWORD>@127.0.0.1:5435/nexoris_admin?schema=public
DATABASE_URL_CMS=postgresql://nexoristech:<DB_PASSWORD>@127.0.0.1:5435/nexoris_cms?schema=public
DATABASE_URL_OGE=postgresql://nexoristech:<DB_PASSWORD>@127.0.0.1:5435/nexoris_oge?schema=public

OGE_GATEWAY_URL=http://127.0.0.1:4000
OGE_REINGEST_SHARED_SECRET=<OGE_REINGEST_SHARED_SECRET>

# The public website, as a browser reaches it. Used to revalidate pages after publishing.
WEB_ORIGIN=https://nexoristech.com
REVALIDATION_SECRET=<REVALIDATION_SECRET>
INDEXNOW_KEY=<INDEXNOW_KEY>

# APP_URL is the one address here that a person receives.
#
# It goes into invitation and password-reset links, which are now the only way into a new account. If
# the admin is served on a real hostname, set it to that hostname, with https:// once TLS is in front
# of it. If it is reached by IP and port for now, LEAVE THIS COMMENTED OUT: the code then uses the
# host the request actually arrived on, which is by definition an address that resolves. A loopback
# value is ignored in production precisely because it cannot be opened by anyone else.
#
# APP_URL=https://app.nexoristech.com

# Where uploaded media is stored on disk.
#
# This must be outside the application directory. Media used to live in apps/admin/public/uploads,
# and the first deployment destroyed every file: the deploy replaced the app directory, while the
# cms_media rows and every featured_image column survived, so the library went on describing files
# that were no longer there. Uploads are user data and belong next to the database, not next to the
# code that gets replaced.
#
# The public URL is unaffected. Files are still addressed as /uploads/<name>; only the directory
# behind that address moved, so nothing already stored needs rewriting. Because the directory is
# outside public/, Next no longer serves it statically — the admin serves it from
# app/uploads/[...path]/route.ts, and the website proxies its own /uploads/* to the admin.
#
# The directory must exist and be writable by the user running the admin:
#   sudo mkdir -p /media/nexoris && sudo chown -R $USER:$USER /media/nexoris
MEDIA_STORAGE_PATH=/media/nexoris

ADMIN_SESSION_SECRET=<ADMIN_SESSION_SECRET>
ADMIN_SETTINGS_KEY=<ADMIN_SETTINGS_KEY>

GSC_PROPERTY=sc-domain:nexoristech.com
GA4_PROPERTY_ID=492452479

# ADMIN_SEED_EMAIL / ADMIN_SEED_PASSWORD / ADMIN_SEED_NAME are deliberately absent. The seed script is
# idempotent on email, so a deployment that carries them can recreate an administrator that was
# deliberately retired. Set them only to bootstrap a brand-new database, then remove them.


# ----------------------------------------------------------------------------------------------------
# /var/www/nexoristech/.env                          (the Oge gateway, port 4000)
# ----------------------------------------------------------------------------------------------------
# The gateway reads the repository-root .env rather than a per-app file.

DATABASE_URL_OGE=postgresql://nexoristech:<DB_PASSWORD>@127.0.0.1:5435/nexoris_oge?schema=public
DATABASE_URL_ADMIN=postgresql://nexoristech:<DB_PASSWORD>@127.0.0.1:5435/nexoris_admin?schema=public
DATABASE_URL_CMS=postgresql://nexoristech:<DB_PASSWORD>@127.0.0.1:5435/nexoris_cms?schema=public

OGE_PORT=4000
OGE_REINGEST_SHARED_SECRET=<OGE_REINGEST_SHARED_SECRET>

GEMINI_API_KEY_PROJECT_A=<GEMINI_API_KEY_PROJECT_A>
GEMINI_API_KEY_PROJECT_B=<GEMINI_API_KEY_PROJECT_B>
MISTRAL_API_KEY=<MISTRAL_API_KEY>
GROQ_API_KEY=<GROQ_API_KEY>

MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_API_KEY=<MEILISEARCH_API_KEY>


# ====================================================================================================
# Signing in over plain HTTP
# ====================================================================================================
#
# The session cookie is marked Secure only when the browser's connection is HTTPS, judged from
# x-forwarded-proto and falling back to the request URL. That is what makes http://<host>:3102 usable
# while a real certificate is still being arranged: a Secure cookie on a plain HTTP connection is
# discarded by the browser without a word, so the sign-in succeeds and the next page has no session.
#
# If a reverse proxy sits in front, it must pass the header through, or the cookie will not be marked
# Secure even on an HTTPS site:
#
#   proxy_set_header X-Forwarded-Proto $scheme;
#   proxy_set_header X-Forwarded-Host  $host;
#   proxy_set_header Host              $host;
#
# Put TLS in front of the admin as soon as there is a hostname for it. Session cookies crossing a
# network in clear text is a real exposure; this only stops the platform from locking its own
# administrator out before that is in place.
