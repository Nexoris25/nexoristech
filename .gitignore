# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.next/
next-env.d.ts
out/
.turbo/
.strapi/
.cache/
*.tsbuildinfo

# Environment and secrets (only .env.example is committed)
.env
.env.*
!.env.example
*.pem
*.key

# Google Cloud credentials — never commit (keyless ADC / OAuth). GSC + GA4 config lives in .env.local.
application_default_credentials.json
*application_default_credentials.json
*-gcp-credentials.json
*-gcp-key.json
gha-creds-*.json
.gcloud/
gcp-credentials/

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# Editor and OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Test and coverage
coverage/
.nyc_output/
playwright-report/
test-results/

# Strapi runtime
apps/cms/.tmp/
apps/cms/.strapi/
apps/cms/public/uploads/*
!apps/cms/public/uploads/.gitkeep
apps/cms/types/generated/

# Local media (served from the VPS in production)
.media/

# Generated knowledge-base artifact (emitted by the web build, ingested by apps/oge).
/artifacts/

# Local AI coding-agent configuration and scratch state. These describe how a particular
# developer's tooling is set up, not how the product is built, so a clone should not carry them.
.claude/
CLAUDE.md
AGENTS.md
.cursor/
.cursorrules
.aider*
.windsurfrules
.github/copilot-instructions.md
