{
  "kind": "singleType",
  "collectionName": "privacy_policy",
  "info": {
    "singularName": "privacy-policy",
    "pluralName": "privacy-policies",
    "displayName": "Privacy Policy",
    "description": "The privacy policy, as section and plain-summary pairs (PRD legal pages)."
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "default": "Privacy Policy"
    },
    "intro": {
      "type": "text"
    },
    "effectiveDate": {
      "type": "date"
    },
    "sections": {
      "type": "component",
      "repeatable": true,
      "component": "shared.legal-section"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
