{
  "kind": "collectionType",
  "collectionName": "pseo_pages",
  "info": {
    "singularName": "pseo-page",
    "pluralName": "pseo-pages",
    "displayName": "Programmatic Page",
    "description": "A programmatic SEO permutation page (PRD 9.4 to 9.7). Unpublished by default; the publish guard enforces the non-negotiable quality and data-readiness gate before it can go live."
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "slug": {
      "type": "uid",
      "required": true
    },
    "h1": {
      "type": "string",
      "required": true
    },
    "intent": {
      "type": "enumeration",
      "enum": ["capability", "cost", "comparison"],
      "default": "capability",
      "required": true
    },
    "industryLabel": { "type": "string" },
    "techLabel": { "type": "string" },
    "location": { "type": "string" },
    "summary": { "type": "text" },
    "body": { "type": "richtext" },
    "painPoints": { "type": "richtext" },
    "pricing": { "type": "richtext" },
    "comparison": { "type": "richtext" },
    "hasProprietaryInsight": { "type": "boolean", "default": false },
    "featureMatrix": {
      "type": "component",
      "repeatable": true,
      "component": "shared.metric"
    },
    "dataSources": {
      "type": "component",
      "repeatable": true,
      "component": "shared.source"
    },
    "localDataPoints": {
      "type": "component",
      "repeatable": true,
      "component": "shared.source"
    },
    "faq": {
      "type": "component",
      "repeatable": true,
      "component": "shared.faq-item"
    },
    "author": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::author.author"
    },
    "factChecker": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::author.author"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
