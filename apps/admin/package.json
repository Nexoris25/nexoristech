{
  "name": "@nexoris/admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Nexoris Technologies internal admin dashboard. A modular staff platform on PostgreSQL (nexoris_admin), Oge-integrated. This build delivers the shared shell and its first module, the CRM.",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev --webpack -p 3001",
    "build": "next build --webpack",
    "start": "next start -p 3001",
    "lint": "eslint src",
    "type-check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed:admin": "tsx scripts/seed-admin.ts",
    "db:seed:dev": "tsx scripts/seed-dev.ts",
    "db:migrate:cms": "tsx scripts/migrate-cms.ts"
  },
  "dependencies": {
    "@nexoris/recommend": "workspace:*",
    "@nexoris/ui": "workspace:*",
    "@react-pdf/renderer": "4.1.6",
    "bcryptjs": "2.4.3",
    "decimal.js": "10.6.0",
    "google-auth-library": "9.15.0",
    "lucide-react": "1.23.0",
    "next": "16.2.10",
    "pg": "8.13.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@nexoris/config": "workspace:*",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "autoprefixer": "10.4.20",
    "eslint": "9.17.0",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
