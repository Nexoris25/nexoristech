# Nexoris Technologies Digital Platform: environment template.
#
# Copy this file to .env and fill in real values for local development. Never commit a real
# .env file. Production values live on the VPS, outside the repository. Every value below is a
# safe placeholder.

# ----------------------------------------------------------------------------------------------------
# General
# ----------------------------------------------------------------------------------------------------
NODE_ENV=development

# The public site origin. Used for canonical URLs, Open Graph, sitemaps, llms.txt, and
# metadataBase. No trailing slash on the origin itself.
SITE_URL=https://nexoristech.com

# ----------------------------------------------------------------------------------------------------
# PostgreSQL: one server, a database per app. Provide the real credentials per database.
# ----------------------------------------------------------------------------------------------------
# Strapi CMS database.
DATABASE_URL_CMS=postgresql://nexoris:password@localhost:5432/nexoris_cms
# Oge AI gateway database (with the pgvector extension).
DATABASE_URL_OGE=postgresql://nexoris:password@localhost:5432/nexoris_oge
# Internal admin dashboard (CRM module) database.
DATABASE_URL_ADMIN=postgresql://nexoris:password@localhost:5432/nexoris_admin

# ----------------------------------------------------------------------------------------------------
# AI provider keys. Consumed only by apps/oge. The browser never calls a provider directly.
# Verify every model identifier against the provider's current official documentation before
# pinning it in apps/oge/src/config/models.ts.
# ----------------------------------------------------------------------------------------------------
# Website Bot tier (Google AI Studio, Project A).
GEMINI_API_KEY_PROJECT_A=your-gemini-project-a-key
# CRM Worker tier (Google AI Studio, Project B, a separate Google Cloud project so the daily
# quota is independent of Project A).
GEMINI_API_KEY_PROJECT_B=your-gemini-project-b-key
GROQ_API_KEY=your-groq-key
# Mistral AI (Mistral Large, Ministral 8B, Mistral Embed). Replaced SambaNova; see DECISIONS D-012.
MISTRAL_API_KEY=your-mistral-key

# ----------------------------------------------------------------------------------------------------
# Media storage on the VPS. No CDN. Images are converted to WebP at upload.
# ----------------------------------------------------------------------------------------------------
# Absolute path on the VPS disk where uploaded media is written.
VPS_MEDIA_PATH=/var/www/nexoris/media
# Public base URL the VPS serves media files from.
VPS_MEDIA_BASE_URL=https://nexoristech.com/media

# ----------------------------------------------------------------------------------------------------
# Internal service secrets.
# ----------------------------------------------------------------------------------------------------
# Shared secret apps/web uses to trigger Next.js on-demand revalidation from CMS webhooks.
REVALIDATION_SECRET=change-me-revalidation-secret
# Shared secret apps/oge uses to authenticate to the admin dashboard CRM intake endpoint.
CRM_INTAKE_SHARED_SECRET=change-me-crm-intake-secret
# Shared secret the CMS uses to call the Oge re-ingestion endpoint on publish.
OGE_REINGEST_SHARED_SECRET=change-me-oge-reingest-secret

# ----------------------------------------------------------------------------------------------------
# Meilisearch: site and Insights search plus Oge keyword retrieval. apps/oge indexes with the
# admin API key; the browser searches with the search-only key. The master key is the server
# root credential, used to mint the scoped keys, not for day-to-day app calls.
# ----------------------------------------------------------------------------------------------------
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=your-meili-admin-api-key
MEILISEARCH_MASTER_KEY=your-meili-master-key
MEILISEARCH_SEARCH_KEY=your-meili-search-only-key

# ----------------------------------------------------------------------------------------------------
# Strapi (apps/cms) secrets. Generate strong random values for each in real environments.
# ----------------------------------------------------------------------------------------------------
STRAPI_APP_KEYS=key1,key2,key3,key4
STRAPI_API_TOKEN_SALT=change-me-api-token-salt
STRAPI_ADMIN_JWT_SECRET=change-me-admin-jwt-secret
STRAPI_TRANSFER_TOKEN_SALT=change-me-transfer-token-salt
STRAPI_JWT_SECRET=change-me-jwt-secret
STRAPI_URL=http://localhost:1337

# ----------------------------------------------------------------------------------------------------
# Internal admin dashboard (apps/admin) auth.
# ----------------------------------------------------------------------------------------------------
ADMIN_JWT_SECRET=change-me-admin-dashboard-jwt-secret
ADMIN_SESSION_SECRET=change-me-admin-session-secret

# ----------------------------------------------------------------------------------------------------
# Oge gateway public origin (consumed by apps/web for chat, finder, form-assist, submit).
# ----------------------------------------------------------------------------------------------------
OGE_GATEWAY_URL=http://localhost:4000
NEXT_PUBLIC_OGE_GATEWAY_URL=http://localhost:4000

# Read-only CMS content API origin consumed by apps/web for proof data.
CMS_CONTENT_API_URL=http://localhost:1337/api
