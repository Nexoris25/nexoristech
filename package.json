{
  "name": "nexoristech",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Nexoris Technologies Digital Platform monorepo: marketing site, Oge AI gateway, and the internal admin dashboard (CRM, Finance, HR, Payroll, NRS e-Invoicing, and a custom CMS).",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=12 <13"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "doctor": "node scripts/doctor.mjs",
    "check:seo": "turbo run check:seo",
    "check:a11y": "turbo run check:a11y",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\""
  },
  "devDependencies": {
    "@nexoris/config": "workspace:*",
    "eslint": "10.10.0",
    "prettier": "3.4.2",
    "turbo": "2.10.9",
    "typescript": "5.7.2"
  }
}
