{
  "name": "nexoristech",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Nexoris Technologies Digital Platform monorepo: marketing site, Oge AI gateway, and the internal admin dashboard (CRM, Finance, HR, Payroll, NRS e-Invoicing, and a custom CMS).",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=9 <10"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "check:seo": "turbo run check:seo",
    "check:a11y": "turbo run check:a11y",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\""
  },
  "devDependencies": {
    "@nexoris/config": "workspace:*",
    "eslint": "10.10.0",
    "prettier": "3.4.2",
    "turbo": "2.10.9",
    "typescript": "5.7.2"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.2",
      "@types/react-dom": "19.0.2",
      "sharp": "^0.35.3",
      "multer": "^2.2.0",
      "nanoid": "^3.3.17",
      "postcss": "^8.5.26",
      "esbuild": "^0.25.0",
      "qs": "^6.15.2",
      "body-parser": "^1.20.6",
      "tmp": "^0.2.6",
      "cookie": "^0.7.0",
      "ip-address": "^10.3.1",
      "@eslint/plugin-kit": "^0.3.4",
      "playwright": "^1.62.1",
      "@playwright/test": "^1.62.1",
      "brace-expansion@1": "^1.1.18",
      "brace-expansion@2": "^2.1.4",
      "js-yaml@3": "^3.15.1",
      "js-yaml@4": "^4.3.1",
      "path-to-regexp@0.1": "^0.1.13",
      "vite": "^6.4.3",
      "uuid": "^11.1.1"
    }
  }
}
