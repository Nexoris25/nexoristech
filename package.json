{
  "name": "nexoristech",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Nexoris Technologies Digital Platform monorepo: marketing site, CMS, Oge AI gateway, and the internal admin dashboard with the CRM module.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=9 <10"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "check:seo": "turbo run check:seo",
    "check:a11y": "turbo run check:a11y",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\""
  },
  "devDependencies": {
    "@nexoris/config": "workspace:*",
    "eslint": "9.17.0",
    "prettier": "3.4.2",
    "turbo": "2.3.3",
    "typescript": "5.7.2"
  }
}
